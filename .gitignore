npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------------------------------------------------------------- Model and corpus artefacts
# Trained weights, ONNX exports and raw corpus captures are large and are published to the
# Hugging Face Hub instead; `bench/artefacts.json` pins them by digest.
models/
*.onnx
bench/data/raw/
# `make corpus` output: rebuilt from the pinned catalog and the committed plans, labels and
# payloads. Every file below holds third-party tool text (MIT/Apache/BSD/ISC), which is
# published only with a NOTICE (RUNBOOK §4). `corpus.jsonl` is also where the labelling tool
# saves your labels, so back it up yourself until then.
bench/data/real.jsonl
bench/data/constructed.jsonl
bench/data/corpus.jsonl
bench/data/deduped.jsonl
bench/data/labelled.jsonl
bench/data/near_twins.json
bench/data/synthetic/human.jsonl
bench/data/synthetic/model.jsonl
bench/data/synthetic/prompts_used/
# Local backups of the gitignored corpus files (task A2), external clones (A3) and dry runs (E1).
bench/data/_backup/
bench/data/external/
bench/data/_dryrun/
# Reconstructed test-OOD rows and their YARA sidecar (task G2); never redistributed.
bench/data/ood/
# Working copies of the blind labelling sessions (task F4); the gold labels are exported out.
bench/data/_labelling/
# `make reproduce-check` scratch output (training plan C7); compared, never committed.
bench/data/_reproduce/
bench/results/corpus_stats.json
bench/results/dedup_dropped.json
fixtures/scanner/.tools-only.json

