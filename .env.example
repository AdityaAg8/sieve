DATABASE_URL=postgresql+psycopg://sieve:sieve@localhost:5432/sieve
ANTHROPIC_API_KEY=
SIEVE_JUDGE_MODEL=claude-haiku-4-5
SIEVE_JUDGE_ENABLED=true
SIEVE_JUDGE_MAX_CALLS_PER_SCAN=50
SIEVE_DAILY_JUDGE_BUDGET_USD=2.00
SIEVE_DAILY_SCANS_PER_IP=20
SIEVE_MODEL_ID=<you>/sieve-triage-deberta-v3-base
SIEVE_MODEL_REVISION=<sha>
SIEVE_MODEL_CACHE=~/.cache/sieve
SIEVE_USE_ONNX=true
SIEVE_ALLOW_REMOTE_MCP=false
SIEVE_REMOTE_TIMEOUT_SECONDS=10
SIEVE_MAX_TOOLS_PER_SCAN=500
SIEVE_SCAN_TTL_DAYS=7
SIEVE_TRUST_PROXY=false
SIEVE_IP_HASH_SALT=change-me-per-deployment
SIEVE_LOG_LEVEL=INFO
SNYK_TOKEN=
SIEVE_SNYK_MAX_INVOCATIONS=25
WEB_ORIGIN=http://localhost:3000
SIEVE_VERDICT_FLUSH_MS=250
PYTHONUTF8=1
