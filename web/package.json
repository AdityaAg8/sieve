{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "fixtures": "node scripts/copy-fixtures.mjs",
    "postinstall": "node scripts/copy-fixtures.mjs && next typegen",
    "predev": "node scripts/copy-fixtures.mjs && node scripts/mock-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-fixtures.mjs && node scripts/mock-worker.mjs",
    "build": "next build",
    "postbuild": "node scripts/check-no-msw.mjs",
    "start": "next start",
    "lint": "eslint",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "lint:contrast": "node scripts/check-contrast.mjs",
    "lint:bundle": "node scripts/check-no-msw.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "pretest": "node scripts/copy-fixtures.mjs",
    "test": "vitest run --passWithNoTests",
    "pree2e": "node scripts/copy-fixtures.mjs && node scripts/mock-worker.mjs",
    "e2e": "playwright test",
    "gen:types": "openapi-typescript ../schemas/openapi.json -o src/lib/api-types.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "motion": "^13.2.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "msw": {
    "workerDirectory": [
      "mocks"
    ]
  }
}
